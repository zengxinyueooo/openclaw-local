# OpenClaw Gitignore

# macOS
.DS_Store

# Logs
*.log
logs/

# Environment
.env

# Node
node_modules/

# Python
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# Browser data (缓存、用户数据等)
browser/openclaw/user-data/
browser/chrome-extension/

# Agent sessions (会话记录)
agents/main/sessions/*.jsonl
agents/main/sessions/*.jsonl.lock
agents/main/sessions/*.reset.*

# Media files
media/

# SQLite databases
*.sqlite
*.sqlite-journal
*.sqlite-wal

# Backup files
*.bak
*.bak.*

# Cache directories
*/Cache/
*/cache/
*.cache

# Lock files
LOCK
LOG
LOG.old

# Chrome extension cache
extensions/openclaw-elephant-plugin/node_modules/
extensions/openclaw-elephant-plugin/package-lock.json

# Other
*.pma
*.old
